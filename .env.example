# Notarization credentials for scripts/notarize.sh. Copy to .env, which git ignores, and fill in
# one of the two options.

# Option 1: App Store Connect API key (Users and Access › Integrations › Team Keys).
APPLE_API_KEY_PATH=
APPLE_API_KEY_ID=
APPLE_API_ISSUER_ID=

# Option 2: Apple ID with an app-specific password from account.apple.com.
APPLE_ID=
APPLE_TEAM_ID=
APPLE_APP_PASSWORD=

# Optional: which Developer ID certificate to sign with. Defaults to the first one in the keychain.
# CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"
